<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!--
        Suggested punctuation for keyboard suggestion bar.
        Supports Latin + Arabic scripts.
    -->
    <string name="suggested_punctuations">
        !,؟,،,:,؛,",',(),-,/,@,_
    </string>

    <!--
        Characters that should be followed by a space
        (used for auto spacing logic in IME)
    -->
    <string name="symbols_followed_by_space">
        . , ; : ! ? ) ] } ؟ ، ؛
    </string>

