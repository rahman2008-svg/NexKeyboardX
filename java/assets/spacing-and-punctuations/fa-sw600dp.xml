<?xml version="1.0" encoding="utf-8"?>
<!-- Cleaned punctuation configuration for keyboard IME -->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- Symbols suggested between words -->
    <!-- Includes English + Arabic punctuation -->
    <string name="suggested_punctuations">
        !,&#x061F;,&#x061B;,&#x060C;,:,",',(,),|,-,/,@,_
    </string>

    <!-- Symbols that are normally followed by a space -->
    <string name="symbols_followed_by_space">
        .,;:!?)]}&#x061F;&#x061B;&#x060C;
    </string>

    <!-- Symbols that are optionally preceded by space (emoticons support) -->
    <string name="symbols_optionally_preceded_by_space">
        ;:
    </string>

    <!-- Word separators -->
    <string name="symbols_word_separators">
        "&#x0009;&#x0020;&#x000A;&#x00A0;()[]{}*&amp;&lt;&gt;+=|.,;:!?/_-#$`\\%~&#x00BF;&#x00A1;&#x2014;&#x2013;&#x201C;&#x201D;&#x00AB;&#x00BB;&#x2026;
    </string>

    <!-- Word connectors -->
    <string name="symbols_word_connectors">
        '
    </string>

    <!-- Sentence terminators -->
    <string name="symbols_sentence_terminators">
        .?!
    </string>

</resources>
