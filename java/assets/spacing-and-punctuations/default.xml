<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!--
        Keyboard punctuation + spacing behavior configuration
        Used by IME engine for smart typing, spacing, and capitalization
    -->

    <!-- Suggested punctuation shown in suggestion bar -->
    <string name="suggested_punctuations">
        !,?,\,,:,;,",(),',-,/,@,_
    </string>

    <!-- Symbols that should appear AFTER a space -->
    <string name="symbols_followed_by_space">
        . , ; : ! ? ) ] }
    </string>

    <!-- Symbols optionally preceded by space (emoticons support) -->
    <string name="symbols_optionally_preceded_by_space">
        ; :
    </string>

    <!-- Symbols that follow space only if previous char is space -->
    <string name="symbols_followed_by_space_iff_preceded_by_space">
        - &
    </string>

    <!-- Word separators (spaces, punctuation, and control chars) -->
    <string name="symbols_word_separators">
        "&#x0009;&#x0020;&#x000A;&#x00A0;"()[]{}*<>=|.,;:!?/_"-#$`\%&#x00bf;&#x00a1;&#x2014;&#x2013;&#x201e;&#x201c;&#x201d;&#x00ab;&#x00bb;&#x2039;&#x203a;&#x2026;~
    </string>

    <!-- Word connectors (apostrophe for contractions) -->
    <string name="symbols_word_connectors">
        '
    </string>

    <!-- Sentence behavior -->
    <integer name="sentence_separator">46</integer>
    <integer name="abbreviation_marker">46</integer>

    <!-- Characters that end sentences -->
    <string name="symbols_sentence_terminators">
        .?!
    </string>

    <!-- Language configuration -->
    <bool name="current_language_has_spaces">true</bool>

</resources>
